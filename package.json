{
  "name": "dad-food-d1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create dad-food-db --location=apac",
    "db:migrate:local": "wrangler d1 migrations apply dad-food-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dad-food-db --remote",
    "db:seed:local": "wrangler d1 execute dad-food-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute dad-food-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
