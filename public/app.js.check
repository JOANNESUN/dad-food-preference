
const CATS=['全部','早餐','午餐','晚餐','點心','甜食','高蛋白','纖維','軟質','湯品','海鮮','冷食'];
const state={items:[],nextCursor:null,loading:false,filter:'全部',current:0,done:false};
const reactionLabel={want:'😍 想吃',maybe:'🙂 可以',no:'🙅 不想吃'};
function escapeHtml(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function photoBlock(item,cls,eager=false){if(!item.has_photo)return `<div class="${cls}"><div class="missing">📷<br>還沒有照片<br><span class="small">料理 ID ${item.id}</span></div></div>`;return `<div class="${cls}"><img src="${item.image_url}" alt="${escapeHtml(item.name)}" loading="${eager?'eager':'lazy'}" decoding="async"></div>`}
async function api(url,options){const r=await fetch(url,options);if(!r.ok){let d={};try{d=await r.json()}catch{}throw new Error(d.error||`HTTP ${r.status}`)}return r.headers.get('content-type')?.includes('application/json')?r.json():r}
function renderFilters(){filters.innerHTML=CATS.map(c=>`<button class="chip ${c===state.filter?'active':''}" data-c="${c}">${c}</button>`).join('');filters.querySelectorAll('button').forEach(b=>b.onclick=()=>reset(b.dataset.c))}
async function reset(cat='全部'){state.filter=cat;state.items=[];state.nextCursor=null;state.current=0;state.done=false;renderFilters();feed.innerHTML='';hero.innerHTML='<div class="missing">載入中…</div>';await loadMore();renderAll()}
async function loadMore(){if(state.loading||state.done)return;state.loading=true;try{const p=new URLSearchParams({limit:'10'});if(state.filter!=='全部')p.set('category',state.filter);if(state.nextCursor)p.set('cursor',state.nextCursor);const d=await api('/api/foods?'+p);state.items.push(...d.items);state.nextCursor=d.nextCursor;state.done=!d.nextCursor}catch(e){feed.innerHTML=`<div class="sentinel">${escapeHtml(e.message)}</div>`}finally{state.loading=false}}
async function react(id,reaction){await api(`/api/foods/${id}/reactions`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({reaction})});const item=state.items.find(x=>x.id===id);if(item)item.latest_reaction=reaction;renderHero();loadStats();if(document.getElementById('history').classList.contains('active'))loadHistory()}
function renderHero(){if(!state.items.length){hero.innerHTML='<div class="missing">這個分類還沒有料理。</div>';return}if(state.current>=state.items.length)state.current=0;const x=state.items[state.current];hero.innerHTML=`<article class="hero">${photoBlock(x,'hero-photo',true)}<div class="body"><div class="name">${escapeHtml(x.name)}</div><div class="rest">${escapeHtml(x.restaurant||'家裡 / 其他')} · ID ${x.id}</div><div class="tags">${x.tags.map(t=>`<span class="tag">${escapeHtml(t)}</span>`).join('')}</div><div class="reacts"><button class="yes" data-r="want">😍 想吃</button><button class="maybe" data-r="maybe">🙂 可以</button><button class="no" data-r="no">🙅 不想吃</button></div><div class="navrow"><button id="prev">← 上一個</button><button id="next">下一個 →</button></div>${x.latest_reaction?`<div class="small" style="margin-top:9px">上次：${reactionLabel[x.latest_reaction]}</div>`:''}</div></article><div class="swipe">← 左右滑動看上一個 / 下一個 →</div>`;hero.querySelectorAll('[data-r]').forEach(b=>b.onclick=()=>react(x.id,b.dataset.r));prev.onclick=()=>{state.current=(state.current-1+state.items.length)%state.items.length;renderHero()};next.onclick=async()=>{if(state.current>=state.items.length-2&&!state.done)await loadMore();state.current=(state.current+1)%state.items.length;renderAll()}}
function renderFeed(){feed.innerHTML=state.items.map((x,i)=>`<article class="card" data-index="${i}">${photoBlock(x,'photo')}<div class="cbody"><div class="cname">${escapeHtml(x.name)}</div><div class="crest">${escapeHtml(x.restaurant||'')} · ID ${x.id}</div><div class="mini-reacts"><button class="yes" data-id="${x.id}" data-r="want">😍 想吃</button><button class="maybe" data-id="${x.id}" data-r="maybe">🙂 可以</button><button class="no" data-id="${x.id}" data-r="no">🙅 不想</button></div></div></article>`).join('')+`<div id="sentinel" class="sentinel">${state.done?'已經看到全部料理了':'繼續往下滑，還有更多料理…'}</div>`;feed.querySelectorAll('[data-r]').forEach(b=>b.onclick=e=>{e.stopPropagation();react(Number(b.dataset.id),b.dataset.r)});feed.querySelectorAll('.card').forEach(c=>c.onclick=e=>{if(e.target.closest('[data-r]'))return;state.current=Number(c.dataset.index);window.scrollTo({top:0,behavior:'smooth'});renderHero()});observeSentinel()}
let obs;function observeSentinel(){obs?.disconnect();const s=document.getElementById('sentinel');if(!s||state.done)return;obs=new IntersectionObserver(async es=>{if(es.some(e=>e.isIntersecting)){const before=state.items.length;await loadMore();if(state.items.length!==before)renderFeed()}},{rootMargin:'500px 0px'});obs.observe(s)}
function renderAll(){renderHero();renderFeed()}
let sx=0,sy=0;hero.addEventListener('touchstart',e=>{const t=e.changedTouches[0];sx=t.screenX;sy=t.screenY},{passive:true});hero.addEventListener('touchend',async e=>{const t=e.changedTouches[0],dx=t.screenX-sx,dy=t.screenY-sy;if(Math.abs(dx)<45||Math.abs(dx)<Math.abs(dy))return;if(dx<0){if(state.current>=state.items.length-2&&!state.done)await loadMore();state.current=(state.current+1)%state.items.length}else state.current=(state.current-1+state.items.length)%state.items.length;renderAll()},{passive:true});
async function compress(file,max=900,q=.68){const url=await new Promise(res=>{const r=new FileReader();r.onload=()=>res(r.result);r.readAsDataURL(file)});const img=await new Promise(res=>{const i=new Image();i.onload=()=>res(i);i.src=url});const scale=Math.min(1,max/Math.max(img.width,img.height)),c=document.createElement('canvas');c.width=Math.round(img.width*scale);c.height=Math.round(img.height*scale);c.getContext('2d').drawImage(img,0,0,c.width,c.height);const data=c.toDataURL('image/jpeg',q);return {imageMime:'image/jpeg',imageBase64:data.split(',')[1],preview:data}}
let pending=null;photo.onchange=async()=>{if(!photo.files[0])return;pending=await compress(photo.files[0]);previewImg.src=pending.preview;preview.style.display='block'};
picker.innerHTML=CATS.filter(x=>x!=='全部').map(c=>`<label><input type="checkbox" value="${c}"><span>${c}</span></label>`).join('');
form.onsubmit=async e=>{e.preventDefault();formError.innerHTML='';try{if(!pending)throw new Error('請先選一張食物照片');const tags=[...picker.querySelectorAll('input:checked')].map(x=>x.value);await api('/api/foods',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name:name.value.trim(),restaurant:restaurant.value.trim(),tags,imageMime:pending.imageMime,imageBase64:pending.imageBase64})});form.reset();pending=null;preview.style.display='none';await reset('全部');switchTab('dad')}catch(err){formError.innerHTML=`<div class="error">${escapeHtml(err.message)}</div>`}};
updatePhoto.onclick=async()=>{try{const id=Number(existingId.value),file=existingPhoto.files[0];if(!id||!file)throw new Error('請填料理 ID 並選照片');const p=await compress(file);await api(`/api/foods/${id}/image`,{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify({imageMime:p.imageMime,imageBase64:p.imageBase64})});alert('照片已更新');await reset(state.filter)}catch(e){alert(e.message)}};
async function loadStats(){try{const d=await api('/api/stats');sw.textContent=d.want;sm.textContent=d.maybe;sn.textContent=d.no}catch{}}
async function loadHistory(){try{const d=await api('/api/history');historyBox.innerHTML=d.items.length?d.items.map(x=>`<div class="history-item"><div class="history-top"><strong>${escapeHtml(x.name)}</strong><span>${reactionLabel[x.reaction]}</span></div><div class="small">${escapeHtml(x.restaurant||'')} · ${escapeHtml(x.created_at)}</div></div>`).join(''):'<div class="missing">還沒有紀錄。</div>'}catch(e){historyBox.innerHTML=`<div class="error">${escapeHtml(e.message)}</div>`}}
function switchTab(id){document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.tab===id));if(id==='add')loadStats();if(id==='history')loadHistory()}
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>switchTab(t.dataset.tab));renderFilters();reset('全部');
