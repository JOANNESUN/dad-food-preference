{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dad-food-app",
	"main": "src/index.js",
	"compatibility_date": "2026-09-03",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dad-food-db",
			"database_id": "cf8a5e9f-823c-42b7-bbb0-0a411cf08316"
		}
	]
}