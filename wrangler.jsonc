{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dad-food-app",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dad-food-db",
      "database_id": "00000000-0000-0000-0000-000000000000" // replace with the UUID printed by `wrangler d1 create`
    }
  ]
}
